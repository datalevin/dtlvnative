#!/bin/bash

set -eou pipefail

ROOT_DIR=$(
  CDPATH= cd -- "$(dirname "$0")/.." && pwd
)

export SOEXT=.so

# build usearch

cd src/usearch

sh ../../script/apply-usearch-gcc-patch

SIMSIMD_X86_FLAGS=""
if [ "$(uname -m)" = "x86_64" ]; then
    SIMSIMD_X86_FLAGS="-D SIMSIMD_TARGET_HASWELL=1 \
    -D SIMSIMD_TARGET_SKYLAKE=1 \
    -D SIMSIMD_TARGET_ICE=1 \
    -D SIMSIMD_TARGET_GENOA=1 \
    -D SIMSIMD_TARGET_SAPPHIRE=1 \
    -D SIMSIMD_TARGET_TURIN=1 \
    -D SIMSIMD_TARGET_SIERRA=0"
fi

cmake \
    -D CMAKE_BUILD_TYPE=Release \
    ${SIMSIMD_X86_FLAGS:+$SIMSIMD_X86_FLAGS} \
    -D USEARCH_USE_FP16LIB=1 \
    -D USEARCH_USE_OPENMP=1 \
    -D USEARCH_USE_SIMSIMD=1 \
    -D USEARCH_BUILD_TEST_CPP=1 \
    -D USEARCH_BUILD_TEST_C=1 \
    -D USEARCH_BUILD_LIB_C=1 \
    -B build_release

cmake --build build_release --config Release

build_release/test_cpp
build_release/test_c

# build llama.cpp

cd ../llama.cpp

cmake \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_POSITION_INDEPENDENT_CODE=ON \
    -D BUILD_SHARED_LIBS=OFF \
    -D LLAMA_OPENSSL=OFF \
    -D GGML_CPU=ON \
    -D GGML_OPENMP=ON \
    -D GGML_NATIVE=OFF \
    -D GGML_LLAMAFILE=OFF \
    -D GGML_CPU_REPACK=OFF \
    -D GGML_BACKEND_DL=OFF \
    -D GGML_ACCELERATE=OFF \
    -D GGML_BLAS=OFF \
    -D GGML_CUDA=OFF \
    -D GGML_HIP=OFF \
    -D GGML_METAL=OFF \
    -D GGML_MUSA=OFF \
    -D GGML_OPENCL=OFF \
    -D GGML_RPC=OFF \
    -D GGML_SYCL=OFF \
    -D GGML_VULKAN=OFF \
    -D GGML_WEBGPU=OFF \
    -D LLAMA_BUILD_COMMON=OFF \
    -D LLAMA_BUILD_TESTS=OFF \
    -D LLAMA_BUILD_TOOLS=OFF \
    -D LLAMA_BUILD_MTMD=ON \
    -D LLAMA_BUILD_EXAMPLES=OFF \
    -D LLAMA_BUILD_SERVER=OFF \
    -B build_release

cmake --build build_release --config Release

# build lmdb and dtlv

export LDFLAGS="${LDFLAGS:+$LDFLAGS }-static-libstdc++ -Wl,-rpath,'$$ORIGIN'"
export OMP_LIB="-fopenmp"
export USEARCH_LIB="-Wl,--whole-archive -lusearch -Wl,--no-whole-archive"

cd ..
make clean
make

# Bundle libgomp/libomp so users do not need system packages
GCC_BIN="${CC:-gcc}"
LIBGOMP_SO="$($GCC_BIN -print-file-name=libgomp.so.1)"
if [ -f "${LIBGOMP_SO}" ]; then
    cp "${LIBGOMP_SO}" libgomp.so.1
    cp "${LIBGOMP_SO}" libgomp.so
fi
