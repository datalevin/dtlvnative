#!/bin/bash

set -euo pipefail

ROOT_DIR=$(
  CDPATH= cd -- "$(dirname "$0")/.." && pwd
)
CALLER_DIR=$(pwd)
JAVACPP_VERSION=1.5.13
JAVACPP_JAR="${HOME}/.m2/repository/org/bytedeco/javacpp/${JAVACPP_VERSION}/javacpp-${JAVACPP_VERSION}.jar"

usage() {
  cat <<'EOF'
Usage: script/test-llama-ocr [--vision-model=PATH] [--vision-mmproj=PATH] [--ocr-image=PATH] [--ocr-n-predict=N] [extra Test.java args]

Refresh the JavaCPP platform libraries for the current machine, sync them into
the platform resource directory, and run only the PaddleOCR-VL smoke test.

Required input resolution order:
1. Explicit flags
2. Environment variables
   - DTLV_VISION_MODEL_PATH
   - DTLV_VISION_MMPROJ_PATH
   - DTLV_OCR_IMAGE_PATH
3. Positional arguments in order: MODEL_GGUF MMPROJ_GGUF IMAGE

OCR token budget resolution order:
1. --ocr-n-predict=N
2. DTLV_OCR_N_PREDICT
3. Default: 16

Examples:
  script/test-llama-ocr \
    --vision-model=/tmp/PaddleOCR-VL-1.5.gguf \
    --vision-mmproj=/tmp/PaddleOCR-VL-1.5-mmproj.gguf \
    --ocr-image=/tmp/paddleocr_vl_demo_512.png

  DTLV_VISION_MODEL_PATH=/tmp/PaddleOCR-VL-1.5.gguf \
  DTLV_VISION_MMPROJ_PATH=/tmp/PaddleOCR-VL-1.5-mmproj.gguf \
  DTLV_OCR_IMAGE_PATH=/tmp/paddleocr_vl_demo_512.png \
  DTLV_OCR_N_PREDICT=16 \
  script/test-llama-ocr
EOF
}

die() {
  echo "$*" >&2
  exit 1
}

resolve_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "${CALLER_DIR}/$1" ;;
  esac
}

detect_platform_dir() {
  case "$(uname -s):$(uname -m)" in
    Darwin:arm64|Darwin:aarch64) printf '%s\n' "macosx-arm64" ;;
    Linux:x86_64|Linux:amd64) printf '%s\n' "linux-x86_64" ;;
    Linux:arm64|Linux:aarch64) printf '%s\n' "linux-arm64" ;;
    FreeBSD:x86_64|FreeBSD:amd64) printf '%s\n' "freebsd-x86_64" ;;
    *) return 1 ;;
  esac
}

sync_platform_libs() {
  local generated_dir=$1
  local resource_dir=$2
  local copied=0
  local lib

  mkdir -p "$resource_dir"
  for lib in "$generated_dir"/*; do
    [ -f "$lib" ] || continue
    cp -f "$lib" "$resource_dir"/
    copied=1
  done

  [ "$copied" -eq 1 ] || die "No platform libraries were generated under $generated_dir"
}

stage_native_runtime_libs() {
  local generated_dir=$1
  local native_lib=""
  local runtime_lib

  mkdir -p "$generated_dir"

  for native_lib in "$ROOT_DIR/src/libdtlv.dylib" "$ROOT_DIR/src/libdtlv.so"; do
    if [ -f "$native_lib" ]; then
      cp -f "$native_lib" "$generated_dir"/
      native_lib="staged"
      break
    fi
  done

  [ "$native_lib" = "staged" ] || die "Missing native dtlv library under $ROOT_DIR/src"

  for runtime_lib in "$ROOT_DIR/src/libomp.dylib" "$ROOT_DIR/src/libomp.so"; do
    if [ -f "$runtime_lib" ]; then
      cp -f "$runtime_lib" "$generated_dir"/
    fi
  done
}

ensure_javacpp_jar() {
  local platform_dir=$1

  if [ -f "$JAVACPP_JAR" ]; then
    return 0
  fi

  (
    cd "$ROOT_DIR/$platform_dir"
    lein deps
  )

  [ -f "$JAVACPP_JAR" ] || die "Missing JavaCPP jar at $JAVACPP_JAR"
}

PLATFORM_DIR=$(detect_platform_dir) || die "Unsupported platform: $(uname -s) $(uname -m)"
PROJECT_DIR="$ROOT_DIR/$PLATFORM_DIR"
GENERATED_DIR="$ROOT_DIR/src/java/datalevin/dtlvnative/$PLATFORM_DIR"
RESOURCE_DIR="$PROJECT_DIR/resources/datalevin/dtlvnative/$PLATFORM_DIR"

[ -d "$PROJECT_DIR" ] || die "Missing platform project directory: $PROJECT_DIR"

VISION_MODEL="${DTLV_VISION_MODEL_PATH:-}"
VISION_MMPROJ="${DTLV_VISION_MMPROJ_PATH:-}"
OCR_IMAGE="${DTLV_OCR_IMAGE_PATH:-}"
OCR_N_PREDICT="${DTLV_OCR_N_PREDICT:-16}"
PASS_THROUGH_ARGS=()
POSITIONAL_ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --vision-model=*)
      VISION_MODEL=${1#*=}
      ;;
    --vision-mmproj=*)
      VISION_MMPROJ=${1#*=}
      ;;
    --ocr-image=*)
      OCR_IMAGE=${1#*=}
      ;;
    --ocr-n-predict=*)
      OCR_N_PREDICT=${1#*=}
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        PASS_THROUGH_ARGS+=("$1")
        shift
      done
      break
      ;;
    -*)
      PASS_THROUGH_ARGS+=("$1")
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      ;;
  esac
  shift
done

if [ -z "$VISION_MODEL" ] && [ "${#POSITIONAL_ARGS[@]}" -ge 1 ]; then
  VISION_MODEL=${POSITIONAL_ARGS[0]}
fi
if [ -z "$VISION_MMPROJ" ] && [ "${#POSITIONAL_ARGS[@]}" -ge 2 ]; then
  VISION_MMPROJ=${POSITIONAL_ARGS[1]}
fi
if [ -z "$OCR_IMAGE" ] && [ "${#POSITIONAL_ARGS[@]}" -ge 3 ]; then
  OCR_IMAGE=${POSITIONAL_ARGS[2]}
fi
if [ "${#POSITIONAL_ARGS[@]}" -gt 3 ]; then
  for extra_arg in "${POSITIONAL_ARGS[@]:3}"; do
    PASS_THROUGH_ARGS+=("$extra_arg")
  done
fi

[ -n "$VISION_MODEL" ] || die "Missing vision model. Pass --vision-model=... or set DTLV_VISION_MODEL_PATH."
[ -n "$VISION_MMPROJ" ] || die "Missing vision mmproj. Pass --vision-mmproj=... or set DTLV_VISION_MMPROJ_PATH."
[ -n "$OCR_IMAGE" ] || die "Missing OCR image. Pass --ocr-image=... or set DTLV_OCR_IMAGE_PATH."

VISION_MODEL=$(resolve_path "$VISION_MODEL")
VISION_MMPROJ=$(resolve_path "$VISION_MMPROJ")
OCR_IMAGE=$(resolve_path "$OCR_IMAGE")

[ -f "$VISION_MODEL" ] || die "Vision model does not exist: $VISION_MODEL"
[ -f "$VISION_MMPROJ" ] || die "Vision mmproj does not exist: $VISION_MMPROJ"
[ -f "$OCR_IMAGE" ] || die "OCR image does not exist: $OCR_IMAGE"

case "$OCR_N_PREDICT" in
  ''|*[!0-9-]*)
    die "OCR token budget must be an integer: $OCR_N_PREDICT"
    ;;
esac

if [ ! -f "$ROOT_DIR/src/libdtlv.dylib" ] && [ ! -f "$ROOT_DIR/src/libdtlv.so" ]; then
  die "Missing native dtlv library under src/. Build the native libs before running this test."
fi

ensure_javacpp_jar "$PLATFORM_DIR"

(
  cd "$ROOT_DIR/src/java"
  java -jar "$JAVACPP_JAR" datalevin/dtlvnative/DTLV.java
)

[ -d "$GENERATED_DIR" ] || die "Missing generated platform directory: $GENERATED_DIR"
stage_native_runtime_libs "$GENERATED_DIR"
sync_platform_libs "$GENERATED_DIR" "$RESOURCE_DIR"

echo "Running llama OCR smoke test on $PLATFORM_DIR"
echo "Using vision model: $VISION_MODEL"
echo "Using vision mmproj: $VISION_MMPROJ"
echo "Using OCR image: $OCR_IMAGE"
echo "Using OCR n_predict: $OCR_N_PREDICT"

(
  cd "$PROJECT_DIR"
  if [ "${#PASS_THROUGH_ARGS[@]}" -gt 0 ]; then
    lein run --ocr-only \
      "--vision-model=$VISION_MODEL" \
      "--vision-mmproj=$VISION_MMPROJ" \
      "--ocr-image=$OCR_IMAGE" \
      "--ocr-n-predict=$OCR_N_PREDICT" \
      "${PASS_THROUGH_ARGS[@]}"
  else
    lein run --ocr-only \
      "--vision-model=$VISION_MODEL" \
      "--vision-mmproj=$VISION_MMPROJ" \
      "--ocr-image=$OCR_IMAGE" \
      "--ocr-n-predict=$OCR_N_PREDICT"
  fi
)
